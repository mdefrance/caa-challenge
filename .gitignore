# --- Challenge data (download from ENS, see data/README.md) ---
data/*.csv
data/*.zip
data/*.xlsx

# --- Generated artifacts ---
# carver / xgboost / best_features model artifacts (regenerated by the notebooks).
# Scoped to src/model/ rather than a blanket *.json, which would silently swallow
# any config file added later.
src/model/*
src/model/**/*.json
src/predictions/

# ...except the target carvers that define the severity notebook's stratified split
# (light mode, ~2 kB each). The v76 one is the migrated 2025/7.0.5 artifact and cannot be
# regenerated; the 2026 one is re-fitted by frequency_model_2026.ipynb on every run.
!src/model/cm_carver_freq_tschuprowt_v76_light.json
# 2026 re-fit of the same carver (feature = CM, target = frequency), written light-mode
# by frequency_model_2026.ipynb and consumed by amount_model_2026.ipynb
!src/model/cm_carver_freq_tschuprowt_2026.json
src/train_data.csv
src/dev_data.csv

# --- Python ---
*.pyc
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
.venv/
.venv-705/        # isolated AutoCarver 7.0.5 env, for the timing baselines only
*.ruff_cache/

# --- Misc ---
*.xlsx
/.vscode/
/work/

# nbconvert chain transcripts and the measurement harnesses' stdout -- megabytes of
# progress bars, regenerated by any re-run.
*.log

# local convenience runner: absolute paths, not part of the deliverable
/run_chain.sh
/run_no_carving.sh
/run_sharpen.sh/.sharpen.lock
